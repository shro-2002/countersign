# Copy to .env and fill in. .env is git-ignored. Sandbox credentials only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
GEMINI_API_KEY=
# Local Postgres started by scripts/db_up.sh (or docker compose). Choose any local password.
COUNTERSIGN_DB_PASSWORD=
COUNTERSIGN_DB_URL=postgresql://countersign:CHANGE_ME@localhost:55432/countersign
# Bearer token the web proxy sends to the API on every case request (server-side only). e.g. `openssl rand -hex 32`
COUNTERSIGN_OPERATOR_TOKEN=
# Optional: max LLM requests per agent run (default 12)
# COUNTERSIGN_LLM_BUDGET=12

# --- Hosted judge demo only (leave unset locally). See docs/HOSTING_PLAN.md ---
# Backend: seeded cases only, per-session isolation and caps
# COUNTERSIGN_DEMO_MODE=judge
# Web proxy: access code shared with judges, and a >=32-char secret that signs session cookies
# COUNTERSIGN_DEMO_ACCESS_CODE=
# COUNTERSIGN_SESSION_SECRET=
# COUNTERSIGN_API_URL=http://localhost:8000
